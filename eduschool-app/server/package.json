{
  "name": "eduschool-server",
  "version": "1.0.0",
  "description": "Shamdan backend API",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx src/worker.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "draw-db": "npx prisma generate",
    "db:visualize": "npx prisma generate",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration --runInBand",
    "write-boundary:check": "tsx scripts/check-write-boundary.ts",
    "check:no-console": "tsx scripts/check-no-console.ts",
    "db:check": "npx tsx src/scripts/consistency-check.ts",
    "precheck:db": "npx tsx scripts/precheck-db-invariants.ts",
    "validate:env": "npx tsx scripts/validate-env.ts",
    "validate:env:prod": "npx tsx scripts/validate-env.ts --env production",
    "migrate:check": "npx tsx scripts/migrate-check.ts",
    "smoke": "npx tsx scripts/smoke-test.ts",
    "verify:backup": "npx tsx scripts/verify-backup.ts",
    "predeploy": "npm run validate:env:prod && npm run migrate:check && npm run write-boundary:check && npm run check:no-console && npm run build",
    "postdeploy": "npm run smoke"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.53.1",
    "@simplewebauthn/server": "^13.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/helmet": "^0.0.48",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.76.10",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "json-stable-stringify": "^1.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "otpauth": "^9.5.0",
    "pino": "^9.6.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.12.3",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/json-stable-stringify": "^1.1.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.4",
    "@types/pino": "^7.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prisma-erd-generator": "^2.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
