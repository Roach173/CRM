{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "express", "bcrypt", "cors", "jsonwebtoken"]
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["src/__tests__"]
}
