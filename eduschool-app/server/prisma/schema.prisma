// ─── Phase 4: DB-backed idempotency ──────────────────────────────────────────
//
// Provides race-safe first-write detection for financial endpoints.
// The unique constraint on (schoolId, scopeType, actorId, endpoint, key)
// guarantees only one IN_PROGRESS row can exist per logical operation.
//
// NOTE(Phase 7+): scopeType=SYSTEM/WEBHOOK requires partial unique indexes
// per scope type to correctly handle NULL actorId (PostgreSQL treats
// NULL != NULL in standard B-tree unique indexes). Phase 4 uses USER scope
// only where both schoolId and actorId are always non-null.
// See ARCHITECTURAL_DECISIONS.md §Idempotency-Scope.
model IdempotencyKey {
  id             Int                  @id @default(autoincrement())
  schoolId       Int?
  actorId        Int?
  scopeType      IdempotencyScopeType @default(USER)
  endpoint       String
  key            String
  status         IdempotencyStatus    @default(IN_PROGRESS)
  requestHash    String
  startedAt      DateTime             @default(now())
  responseBody   Json?
  responseStatus Int?
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([schoolId, scopeType, actorId, endpoint, key])
  @@index([expiresAt])
  @@index([status, startedAt])
}

enum IdempotencyScopeType {
  USER
  SYSTEM
  WEBHOOK
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum FreezeType {
  LESSON_SKIP
  PERIOD
}

enum FreezeStatus {
  ACTIVE
  CANCELLED
}

model StudentFreeze {
  id               Int          @id @default(autoincrement())
  schoolId         Int
  studentProfileId Int
  type             FreezeType
  // LESSON_SKIP: lessonSessionId required, startDate/endDate null
  // PERIOD:      lessonSessionId null, startDate required, endDate nullable (null = open-ended)
  lessonSessionId  Int?
  startDate        DateTime?
  endDate          DateTime?
  reason           String?
  status           FreezeStatus @default(ACTIVE)
  createdById      Int
  cancelledById    Int?
  cancelledAt      DateTime?
  createdAt        DateTime     @default(now())

  school          School         @relation(fields: [schoolId], references: [id])
  studentProfile  StudentProfile @relation(fields: [studentProfileId], references: [id])
  lessonSession   LessonSession? @relation(fields: [lessonSessionId], references: [id], onDelete: SetNull)
  createdBy       User           @relation("FreezeCreator", fields: [createdById], references: [id])
  cancelledBy     User?          @relation("FreezeCanceller", fields: [cancelledById], references: [id])

  @@index([schoolId, studentProfileId, status])
  @@index([schoolId, startDate, endDate])
  @@index([lessonSessionId])
  @@index([studentProfileId, status, startDate])
}

// Singleton row (id always 1) for platform-wide config authored by SUPERADMIN.
// Not tenant-scoped — read by every school, written only via /superadmin/help.
model PlatformSettings {
  id        Int      @id @default(1)
  help      Json     @default("[]")
  updatedAt DateTime @updatedAt
}
