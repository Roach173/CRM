generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.svg"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                     Int                        @id @default(autoincrement())
  name                   String
  city                   String
  country                String                     @default("KG")
  timezone               String                     @default("Asia/Bishkek")
  slug                   String                     @unique
  phone                  String?
  email                  String                     @unique
  address                String?
  description            String?
  logoUrl                String?
  isActive               Boolean                    @default(true)
  blockedAt              DateTime?
  settings               Json                       @default("{}")
  onboardingCompleted    Boolean                    @default(false)
  onboardingCompletedAt  DateTime?
  onboardingStep         String?
  createdAt              DateTime                   @default(now())
  deletedAt              DateTime?
  activeDays             Int[]
  workStart              String                     @default("08:00")
  workEnd                String                     @default("20:00")
  slotDuration           Int                        @default(80)
  attendances            Attendance[]
  cabinets               Cabinet[]
  enrollments            EnrollmentRequest[]
  memberships            GroupMembership[]
  blocks                 LessonBlock[]
  creditLogs             LessonCreditLog[]
  sessions               LessonSession[]
  manualLessonEntries    ManualLessonEntry[]
  salaryAdjustments      SalaryAdjustment[]
  scheduleActionLogs     ScheduleActionLog[]
  scheduleExceptions     ScheduleException[]
  financeConfig          SchoolFinanceConfig?
  expenses               Expense[]
  leads                  Lead[]
  leadAttributions       LeadAttribution[]
  marketingCampaigns     MarketingCampaign[]
  marketingSpends        MarketingSpend[]
  npsResponses           NpsResponse[]
  sessionStudents        SessionStudent[]
  groups                 StudentGroup[]
  studentPayments        StudentPayment[]
  subscription           Subscription?
  teacherPayments        TeacherPayment[]
  timeSlots              TimeSlot[]
  users                  User[]
  integrationConnections IntegrationConnection[]
  integrationSyncLogs    IntegrationSyncLog[]
  webhooks               Webhook[]
  webhookDeliveries      WebhookDelivery[]
  policyLogs             SchoolPolicyLog[]
  schedulePolicies       SchoolSchedulePolicy[]
  monthlySummaries       AttendanceMonthlySummary[]
  attendanceAudits       AttendanceAudit[]
  parentProfiles         ParentProfile[]
  groupProgressions      GroupProgression[]
  invoices               Invoice[]
  payments               Payment[]
  creditIssuances        CreditIssuance[]
  paymentRefunds         PaymentRefund[]
  financialAdjustments   FinancialAdjustment[]
  staffInvites           StaffInvite[]
  studentFreezes         StudentFreeze[]
  communicationCampaigns CommunicationCampaign[]
  communicationTemplates CommunicationTemplate[]
  calendarNotes          CalendarNote[]

  @@index([isActive])
  @@index([country])
}

// Shared admin day-notes on the schedule month/week view.
// School-scoped (not per-user): every admin/owner of a school sees and edits the same note for a date.
model CalendarNote {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  date      DateTime @db.Date
  content   String
  authorId  Int? // User.id of last editor, for audit; nullable so deleting a user keeps the note
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
  @@index([schoolId])
}

// Personal per-user day notes on the student calendar (each user sees only their own).
// Distinct from the school-shared admin CalendarNote above.
model StudentCalendarNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  schoolId  Int
  date      DateTime @db.Date
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model Subscription {
  id          String             @id @default(cuid())
  schoolId    Int                @unique
  plan        SubscriptionPlan   @default(TRIAL)
  status      SubscriptionStatus @default(TRIALING)
  trialEndsAt DateTime?
  graceEndsAt DateTime?
  paidUntil   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  school      School             @relation(fields: [schoolId], references: [id])

  @@index([status])
  @@index([trialEndsAt])
  @@index([graceEndsAt])
  @@index([paidUntil])
}

model Cabinet {
  id        Int           @id @default(autoincrement())
  name      String
  capacity  Int           @default(15)
  schoolId  Int
  deletedAt DateTime?
  school    School        @relation(fields: [schoolId], references: [id])
  blocks    LessonBlock[]

  @@index([schoolId])
}

model User {
  id                     Int                   @id @default(autoincrement())
  email                  String?
  username               String?
  password               String
  role                   Role                  @default(STUDENT)
  firstName              String
  lastName               String
  phone                  String?
  schoolId               Int?
  createdAt              DateTime              @default(now())
  deletedAt              DateTime?
  archivedAt             DateTime?
  tokenVersion           Int                   @default(0)
  twoFactorEnabled       Boolean               @default(false)
  totpSecret             String?
  backupCodes            String[]
  emailVerified          Boolean               @default(false)
  verificationToken      String?
  verificationExpires    DateTime?
  submittedAttendances   Attendance[]          @relation("AttendanceSubmitter")
  createdManualEntries   ManualLessonEntry[]   @relation("ManualEntryCreator")
  notifications          Notification[]
  notificationPreferences NotificationPreference[]
  refreshTokens          RefreshToken[]
  resetTokens            ResetToken[]
  createdAdjustments     SalaryAdjustment[]    @relation("AdjustmentCreator")
  scheduleActionLogs     ScheduleActionLog[]
  createdExceptions      ScheduleException[]   @relation("ExceptionCreator")
  financeConfigUpdates   SchoolFinanceConfig[] @relation("FinanceConfigUpdater")
  staffProfile           StaffProfile?
  createdStudentPayments StudentPayment[]      @relation("StudentPaymentCreator")
  createdExpenses        Expense[]             @relation("ExpenseCreator")
  studentProfile         StudentProfile?
  parentProfile          ParentProfile?
  createdPayments        TeacherPayment[]      @relation("PaymentCreator")
  voidedTeacherPayments  TeacherPayment[]      @relation("TeacherPaymentVoider")
  promotedGroups         GroupProgression[]    @relation("ProgressionActor")
  actorCreditLogs        LessonCreditLog[]     @relation("CreditLogActor")
  createdInvoices        Invoice[]             @relation("InvoiceCreator")
  receivedPayments        Payment[]             @relation("PaymentReceiver")
  voidedPayments          Payment[]             @relation("PaymentVoider")
  refundedPayments        Payment[]             @relation("PaymentRefunder")
  issuedCreditIssuances   CreditIssuance[]      @relation("IssuanceActor")
  reversedCreditIssuances CreditIssuance[]      @relation("IssuanceReverser")
  createdRefunds          PaymentRefund[]       @relation("RefundCreator")
  confirmedRefunds        PaymentRefund[]       @relation("RefundConfirmer")
  voidedRefunds           PaymentRefund[]       @relation("RefundVoider")
  creditIssuanceReversals CreditIssuanceReversal[]
  voidedCreditReversals   CreditIssuanceReversal[] @relation("CreditReversalVoider")
  createdFinancialAdjustments FinancialAdjustment[] @relation("FinancialAdjustmentCreator")
  voidedFinancialAdjustments  FinancialAdjustment[] @relation("FinancialAdjustmentVoider")
  createdCommunicationCampaigns CommunicationCampaign[] @relation("CommunicationCampaignCreator")
  createdCommunicationTemplates CommunicationTemplate[] @relation("CommunicationTemplateCreator")
  communicationRecipients       CommunicationRecipient[]
  school                 School?               @relation(fields: [schoolId], references: [id])
  passkeys               UserPasskey[]
  createdFreezes         StudentFreeze[]       @relation("FreezeCreator")
  cancelledFreezes       StudentFreeze[]       @relation("FreezeCanceller")
  finalizedAttendanceSessions LessonSession[]  @relation("AttendanceFinalizer")
  reopenedAttendanceSessions  LessonSession[]  @relation("AttendanceReopener")
  attendanceAudits       AttendanceAudit[]     @relation("AttendanceAuditActor")
  studentCalendarNotes   StudentCalendarNote[]

  // Login identifiers are unique per-school (tenant), not globally: the same
  // person can hold a separate account in each school. NULLs are allowed and
  // Postgres treats them as distinct, so a school may have many email-less users.
  // phone is NOT unique: siblings commonly share one family phone number, so it
  // is a contact field only — the actual login identifier for the second+ child
  // is an auto-generated username (see students.ts POST /, e.g. "<phone>-02").
  @@unique([schoolId, email])
  @@unique([schoolId, username])
  @@index([schoolId, phone])
  @@index([schoolId])
  @@index([role])
  @@index([schoolId, role])
  @@index([deletedAt])
  @@index([schoolId, role, archivedAt])
}

model StudentProfile {
  id                 Int                        @id @default(autoincrement())
  userId             Int                        @unique
  level              String?
  chapter            Int                        @default(1)
  credits            Int                        @default(0)
  // Proportional billing: moneyBalance = som paid toward lessons since the last
  // price change (an accumulator, never decremented). billingLessonsGranted =
  // lessons already granted from it. lessons owed = floor(moneyBalance * billingDays / fee),
  // computed with exact Decimal math so no som is ever lost to rounding.
  moneyBalance       Decimal                    @default(0) @db.Decimal(12, 2)
  billingLessonsGranted Int                     @default(0)
  monthlyFee         Decimal?                   @db.Decimal(10, 2)
  isFrozen           Boolean                    @default(false)
  paidUntil          DateTime?
  isVerified         Boolean                    @default(false)
  deletedAt          DateTime?
  notes              String?
  frozenAt           DateTime?
  atRiskSince        DateTime?
  attendances        Attendance[]
  enrollmentRequests EnrollmentRequest[]
  memberships        GroupMembership[]          @relation("MembershipProfile")
  creditLogs         LessonCreditLog[]
  leads              Lead[]
  sessionStudents    SessionStudent[]
  payments           StudentPayment[]
  monthlySummaries   AttendanceMonthlySummary[]
  parents            ParentChild[]
  invoices           Invoice[]
  financialPayments  Payment[]
  creditIssuances    CreditIssuance[]
  financialAdjustments FinancialAdjustment[]
  attendanceAudits   AttendanceAudit[]
  user               User                       @relation(fields: [userId], references: [id])
  enrolledGroups     StudentGroup[]             @relation("GroupStudents")
  freezes            StudentFreeze[]

  @@index([userId])
  @@index([isFrozen])
  @@index([atRiskSince])
}

model StaffProfile {
  id                  Int                 @id @default(autoincrement())
  userId              Int                 @unique
  salaryRate          Decimal?            @db.Decimal(10, 2)
  position            String?
  hireDate            DateTime?
  deletedAt           DateTime?
  maxLessonsPerDay    Int?
  notes               String?
  rating              Decimal?            @db.Decimal(3, 2)
  workingDays         Int[]               @default([0, 1, 2, 3, 4, 5])
  taughtBlocks        LessonBlock[]       @relation("BlockTeacher")
  substitutions       LessonSession[]     @relation("SessionTeacher")
  manualLessonEntries ManualLessonEntry[]
  salaryAdjustments   SalaryAdjustment[]
  expenses            Expense[]
  user                User                @relation(fields: [userId], references: [id])
  payments            TeacherPayment[]
  rateHistory         TeacherRateLog[]

  @@index([userId])
}

model StudentGroup {
  id            Int                 @id @default(autoincrement())
  schoolId      Int
  level         String
  chapter       Int                 @default(1)
  maxStudents   Int                 @default(15)
  status        GroupStatus         @default(ACTIVE)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime            @default(now())
  deletedAt     DateTime?
  pricePerMonth Decimal?            @db.Decimal(10, 2)
  comment       String?
  enrollments   EnrollmentRequest[]
  memberships   GroupMembership[]   @relation("GroupMemberships")
  blocks        LessonBlock[]
  progressionsFrom GroupProgression[] @relation("ProgressionFrom")
  progressionsTo   GroupProgression[] @relation("ProgressionTo")
  invoiceLines  InvoiceLine[]
  actionLogs    ScheduleActionLog[]
  school        School              @relation(fields: [schoolId], references: [id])
  students      StudentProfile[]    @relation("GroupStudents")

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, deletedAt])
}

model TimeSlot {
  id        Int           @id @default(autoincrement())
  schoolId  Int
  startTime String
  endTime   String
  order     Int           @default(0)
  blocks    LessonBlock[]
  school    School        @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, startTime, endTime])
  @@index([schoolId])
}

model LessonBlock {
  id                 Int                 @id @default(autoincrement())
  schoolId           Int
  cabinetId          Int?
  teacherId          Int?
  startTime          String
  endTime            String
  level              String
  chapter            Int                 @default(1)
  maxStudents        Int                 @default(15)
  type               BlockType           @default(GRAMMAR)
  status             BlockStatus         @default(UPCOMING)
  startDate          DateTime            @default(now())
  endDate            DateTime?
  createdAt          DateTime            @default(now())
  deletedAt          DateTime?
  studentGroupId     Int?
  timeSlotId         Int?
  days               Int[]
  parentBlockId      Int?
  enrollmentRequests EnrollmentRequest[]
  cabinet            Cabinet?            @relation(fields: [cabinetId], references: [id])
  school             School              @relation(fields: [schoolId], references: [id])
  studentGroup       StudentGroup?       @relation(fields: [studentGroupId], references: [id])
  teacher            StaffProfile?       @relation("BlockTeacher", fields: [teacherId], references: [id])
  timeSlot           TimeSlot?           @relation(fields: [timeSlotId], references: [id])
  parent             LessonBlock?        @relation("BlockVersionChain", fields: [parentBlockId], references: [id])
  children           LessonBlock[]       @relation("BlockVersionChain")
  sessions           LessonSession[]
  invoiceLines       InvoiceLine[]
  actionLogs         ScheduleActionLog[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, deletedAt])
  @@index([teacherId])
  @@index([cabinetId])
  @@index([studentGroupId])
  @@index([timeSlotId])
  @@index([schoolId, teacherId])
  @@index([schoolId, timeSlotId])
  @@index([parentBlockId])
}

model LessonSession {
  id                   Int                   @id @default(autoincrement())
  schoolId             Int
  lessonBlockId        Int
  date                 DateTime
  teacherId            Int?
  status               SessionStatus         @default(UPCOMING)
  createdAt            DateTime              @default(now())
  deletedAt            DateTime?
  cabinetIdSnap        Int?
  endTimeSnap          String?
  startTimeSnap        String?
  teacherIdSnap        Int?
  isManualCabinet      Boolean               @default(false)
  isManualDate         Boolean               @default(false)
  isManualTeacher      Boolean               @default(false)
  isManualTime         Boolean               @default(false)
  dateOverrideFrom     DateTime?
  isMakeup             Boolean               @default(false)
  makeupForSessionId   Int?
  version              Int                   @default(0)
  attendanceFinalizedAt DateTime?
  attendanceFinalizedById Int?
  attendanceReopenedAt DateTime?
  attendanceReopenedById Int?
  attendanceReopenReason String?
  attendances          Attendance[]
  attendanceAudits     AttendanceAudit[]
  attendanceFinalizedBy User?                 @relation("AttendanceFinalizer", fields: [attendanceFinalizedById], references: [id])
  attendanceReopenedBy User?                  @relation("AttendanceReopener", fields: [attendanceReopenedById], references: [id])
  lessonBlock          LessonBlock           @relation(fields: [lessonBlockId], references: [id], onDelete: Restrict)
  makeupForSession     LessonSession?        @relation("MakeupSessions", fields: [makeupForSessionId], references: [id])
  studentFreezes       StudentFreeze[]
  makeupSessions       LessonSession[]       @relation("MakeupSessions")
  school               School                @relation(fields: [schoolId], references: [id])
  teacher              StaffProfile?         @relation("SessionTeacher", fields: [teacherId], references: [id])
  actionLogs           ScheduleActionLog[]
  sessionStudents      SessionStudent[]
  teacherPaymentLesson TeacherPaymentLesson?
  creditLogs           LessonCreditLog[]

  @@unique([lessonBlockId, date])
  @@index([schoolId])
  @@index([date])
  @@index([status])
  @@index([schoolId, date])
  @@index([teacherId, date])
  @@index([teacherIdSnap])
  @@index([teacherIdSnap, date])
  @@index([status, date])
  @@index([schoolId, status])
  @@index([attendanceFinalizedAt])
  @@index([attendanceFinalizedById])
  @@index([attendanceReopenedById])
}

model Attendance {
  id               Int              @id @default(autoincrement())
  schoolId         Int
  lessonSessionId  Int
  studentProfileId Int
  status           AttendanceStatus @default(PRESENT)
  creditDeducted   Boolean          @default(false)
  createdAt        DateTime         @default(now())
  sessionStudentId Int?             @unique
  submittedById    Int?
  lessonSession    LessonSession    @relation(fields: [lessonSessionId], references: [id])
  school           School           @relation(fields: [schoolId], references: [id])
  sessionStudent   SessionStudent?  @relation(fields: [sessionStudentId], references: [id])
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id])
  submittedBy      User?            @relation("AttendanceSubmitter", fields: [submittedById], references: [id])
  creditLogs       LessonCreditLog[] @relation("CreditLogAttendance")
  auditRows        AttendanceAudit[]

  @@unique([lessonSessionId, studentProfileId])
  @@index([schoolId])
  @@index([lessonSessionId])
  @@index([studentProfileId])
  @@index([studentProfileId, createdAt])
  @@index([submittedById])
}

model AttendanceAudit {
  id               Int                    @id @default(autoincrement())
  schoolId         Int
  lessonSessionId  Int
  studentProfileId Int?
  attendanceId     Int?
  oldStatus        AttendanceStatus?
  newStatus        AttendanceStatus?
  actorId          Int
  reason           String?
  action           AttendanceAuditAction
  createdAt        DateTime               @default(now())
  school           School                 @relation(fields: [schoolId], references: [id])
  lessonSession    LessonSession          @relation(fields: [lessonSessionId], references: [id])
  studentProfile   StudentProfile?        @relation(fields: [studentProfileId], references: [id])
  attendance       Attendance?            @relation(fields: [attendanceId], references: [id])
  actor            User                   @relation("AttendanceAuditActor", fields: [actorId], references: [id])

  @@index([schoolId, createdAt])
  @@index([lessonSessionId, createdAt])
  @@index([studentProfileId])
  @@index([attendanceId])
  @@index([actorId, createdAt])
  @@index([action])
}

model EnrollmentRequest {
  id               Int              @id @default(autoincrement())
  schoolId         Int
  lessonBlockId    Int?
  studentProfileId Int
  status           EnrollmentStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  studentGroupId   Int?
  priority         Int              @default(0)
  expiresAt        DateTime?
  lessonBlock      LessonBlock?     @relation(fields: [lessonBlockId], references: [id])
  school           School           @relation(fields: [schoolId], references: [id])
  studentGroup     StudentGroup?    @relation(fields: [studentGroupId], references: [id])
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id])

  @@index([schoolId])
  @@index([studentGroupId])
  @@index([lessonBlockId])
  @@index([studentProfileId])
  @@index([studentGroupId, status])
  @@index([studentProfileId, status])
  @@index([studentGroupId, status, createdAt])
}

model LessonCreditLog {
  id               Int               @id @default(autoincrement())
  schoolId         Int
  studentProfileId Int
  sessionId        Int?
  attendanceId     Int?
  paymentId        Int?
  amount           Int
  reason           String
  type             CreditLogType     @default(DEBIT)
  actorId          Int?
  priceSnapshot    Int?
  refundedLogId    Int?
  idempotencyKey   String?
  createdAt        DateTime          @default(now())
  actor            User?             @relation("CreditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  attendance       Attendance?       @relation("CreditLogAttendance", fields: [attendanceId], references: [id], onDelete: SetNull)
  payment          Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  school           School            @relation(fields: [schoolId], references: [id])
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id])
  session          LessonSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  refundedLog      LessonCreditLog?  @relation("CreditLogRefund", fields: [refundedLogId], references: [id], onDelete: SetNull)
  refunds          LessonCreditLog[] @relation("CreditLogRefund")
  issuance         CreditIssuance?   @relation("IssuanceLog")
  reversalOf       CreditIssuance?   @relation("IssuanceReversalLog")
  issuanceReversal CreditIssuanceReversal? @relation("CreditReversalLog")
  voidedReversal   CreditIssuanceReversal? @relation("CreditReversalVoidLog")
  financialAdjustment FinancialAdjustment?

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([studentProfileId])
  @@index([createdAt])
  @@index([studentProfileId, type])
  @@index([attendanceId])
  @@index([paymentId])
}

model TeacherPayment {
  id             Int                    @id @default(autoincrement())
  schoolId       Int
  staffProfileId Int
  period         String
  lessonsCount   Int
  rateSnapshot   Decimal                @db.Decimal(10, 2)
  amount         Decimal                @db.Decimal(10, 2)
  adjustmentNet  Decimal                @default(0) @db.Decimal(10, 2)
  // Void instead of delete (same model as Payment): the record stays as an
  // audit trail with status VOIDED; its TeacherPaymentLesson links are removed
  // so the sessions become payable again. All salary math excludes VOIDED rows.
  status         PaymentStatus          @default(CONFIRMED)
  voidedAt       DateTime?
  voidedById     Int?
  voidReason     String?
  paidAt         DateTime               @default(now())
  createdById    Int?
  note           String?
  idempotencyKey String?
  createdAt      DateTime               @default(now())
  createdBy      User?                  @relation("PaymentCreator", fields: [createdById], references: [id])
  voidedBy       User?                  @relation("TeacherPaymentVoider", fields: [voidedById], references: [id])
  expense        Expense?
  school         School                 @relation(fields: [schoolId], references: [id])
  staffProfile   StaffProfile           @relation(fields: [staffProfileId], references: [id])
  sessions       TeacherPaymentLesson[]

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([staffProfileId])
  @@index([period])
}

model TeacherPaymentLesson {
  id              Int            @id @default(autoincrement())
  paymentId       Int
  lessonSessionId Int            @unique
  payment         TeacherPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  lessonSession   LessonSession  @relation(fields: [lessonSessionId], references: [id])

  @@index([paymentId])
}

model SalaryAdjustment {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  staffProfileId Int
  type           AdjType
  amount         Decimal      @db.Decimal(10, 2)
  reason         String
  month          String
  date           DateTime     @default(now())
  createdById    Int?
  idempotencyKey String?
  createdBy      User?        @relation("AdjustmentCreator", fields: [createdById], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id])

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([staffProfileId])
  @@index([staffProfileId, month])
  @@index([month])
}

model ManualLessonEntry {
  id             Int             @id @default(autoincrement())
  schoolId       Int
  staffProfileId Int
  month          String
  type           ManualEntryType
  label          String
  count          Int
  createdById    Int?
  createdAt      DateTime        @default(now())
  idempotencyKey String?
  createdBy      User?           @relation("ManualEntryCreator", fields: [createdById], references: [id])
  school         School          @relation(fields: [schoolId], references: [id])
  staffProfile   StaffProfile    @relation(fields: [staffProfileId], references: [id])

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([staffProfileId])
  @@index([staffProfileId, month])
  @@index([month])
}

model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int
  schoolId   Int?
  type       String
  category   String    @default("SYSTEM")
  priority   String    @default("NORMAL")
  title      String
  body       String
  actionUrl  String?
  entityType String?
  entityId   Int?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  data       Json?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  communicationRecipients CommunicationRecipient[]

  @@index([userId])
  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([userId, isRead])
  @@index([userId, readAt])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
}

model CommunicationCampaign {
  id              Int                         @id @default(autoincrement())
  schoolId        Int
  createdById     Int
  title           String
  body            String
  category        String
  priority        String
  channel         CommunicationChannel        @default(IN_APP)
  status          CommunicationCampaignStatus @default(DRAFT)
  targetType      CommunicationTargetType
  targetConfig    Json?
  recipientsCount Int                         @default(0)
  sentCount       Int                         @default(0)
  skippedCount    Int                         @default(0)
  failedCount     Int                         @default(0)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  sentAt          DateTime?
  scheduledAt     DateTime?
  school          School                      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy       User                        @relation("CommunicationCampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recipients      CommunicationRecipient[]

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
