  reason      String?
  createdAt   DateTime @default(now())

  school    School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  fromGroup StudentGroup @relation("ProgressionFrom", fields: [fromGroupId], references: [id], onDelete: Restrict)
  toGroup   StudentGroup @relation("ProgressionTo", fields: [toGroupId], references: [id], onDelete: Restrict)
  actor     User         @relation("ProgressionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([fromGroupId])
  @@index([toGroupId])
  @@index([actorId])
}

model Invoice {
  id               Int           @id @default(autoincrement())
  schoolId         Int
  studentProfileId Int
  status           InvoiceStatus @default(DRAFT)
  totalAmount      Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal       @default(0) @db.Decimal(12, 2)
  currencyCode     String        @default("KGS")
  dueDate          DateTime?
  issuedAt         DateTime?
  voidedAt         DateTime?
  note             String?
  periodStart      DateTime?
  periodEnd        DateTime?
  createdById      Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentProfile StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  createdBy      User                @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines          InvoiceLine[]
  allocations    PaymentAllocation[]

  @@index([schoolId, studentProfileId])
  @@index([schoolId, status])
  @@index([schoolId, dueDate])
}

model InvoiceLine {
  id             Int             @id @default(autoincrement())
  invoiceId      Int
  type           InvoiceLineType
  description    String
  quantity       Decimal         @db.Decimal(10, 2)
  unitPrice      Decimal         @db.Decimal(12, 2)
  amount         Decimal         @db.Decimal(12, 2)
  creditsToIssue Int?
  groupId        Int?
  lessonBlockId  Int?
  periodStart    DateTime?
  periodEnd      DateTime?

  invoice     Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  group       StudentGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  lessonBlock LessonBlock?   @relation(fields: [lessonBlockId], references: [id], onDelete: SetNull)
  issuances   CreditIssuance[]

  @@index([invoiceId])
}

model Payment {
  id               Int           @id @default(autoincrement())
  schoolId         Int
  studentProfileId Int
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod @default(CASH)
  status           PaymentStatus @default(CONFIRMED)
  paidAt           DateTime      @default(now())
  receivedById     Int
  note             String?
  voidedAt         DateTime?
  voidedById       Int?
  refundedAt       DateTime?
  refundedById     Int?
  refundPaymentId  Int?
  createdAt        DateTime      @default(now())

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentProfile StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  receivedBy     User                @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  voidedBy       User?               @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  refundedBy     User?               @relation("PaymentRefunder", fields: [refundedById], references: [id], onDelete: SetNull)
  refundPayment  Payment?            @relation("PaymentRefund", fields: [refundPaymentId], references: [id], onDelete: SetNull)
  refunds        Payment[]           @relation("PaymentRefund")
  allocations    PaymentAllocation[]
  creditLogs     LessonCreditLog[]
  refundEvents   PaymentRefund[]
  idempotencyKey String?

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, studentProfileId])
  @@index([schoolId, paidAt])
  @@index([schoolId, status])
}

model PaymentAllocation {
  id        Int     @id @default(autoincrement())
  paymentId Int
  invoiceId Int
  amount    Decimal @db.Decimal(12, 2)

  payment   Payment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice   Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  issuances CreditIssuance[]
  refundAllocations PaymentRefundAllocation[]

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@index([paymentId])
}

model CreditIssuance {
  id                  Int       @id @default(autoincrement())
  schoolId            Int
  paymentAllocationId Int
  invoiceLineId       Int
  studentProfileId    Int
  creditsIssued       Int
  lessonCreditLogId   Int?      @unique
  issuedAt            DateTime  @default(now())
  issuedById          Int
  reversedAt          DateTime?
  reversedById        Int?
  reversalLogId       Int?      @unique
  createdAt           DateTime  @default(now())

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  paymentAllocation PaymentAllocation @relation(fields: [paymentAllocationId], references: [id], onDelete: Restrict)
  invoiceLine       InvoiceLine       @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)
  studentProfile    StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  issuedBy          User              @relation("IssuanceActor", fields: [issuedById], references: [id], onDelete: Restrict)
  reversedBy        User?             @relation("IssuanceReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  lessonCreditLog   LessonCreditLog?  @relation("IssuanceLog", fields: [lessonCreditLogId], references: [id], onDelete: SetNull)
  reversalLog       LessonCreditLog?  @relation("IssuanceReversalLog", fields: [reversalLogId], references: [id], onDelete: SetNull)
  reversals         CreditIssuanceReversal[]
  financialAdjustments FinancialAdjustment[]

  @@unique([paymentAllocationId, invoiceLineId])
  @@index([schoolId])
  @@index([studentProfileId])
  @@index([invoiceLineId])
  @@index([paymentAllocationId])
}

model PaymentRefund {
  id            Int          @id @default(autoincrement())
  schoolId      Int
  paymentId     Int
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  status        RefundStatus @default(PENDING)
  createdById   Int
  confirmedById Int?
  voidedById    Int?
  createdAt     DateTime     @default(now())
  confirmedAt   DateTime?
  voidedAt      DateTime?
  idempotencyKey String?

  school      School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  payment     Payment                   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy   User                      @relation("RefundCreator", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy User?                     @relation("RefundConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  voidedBy    User?                     @relation("RefundVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  allocations PaymentRefundAllocation[]
  adjustments FinancialAdjustment[]

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([paymentId])
  @@index([schoolId, status])
}

model PaymentRefundAllocation {
  id                  Int      @id @default(autoincrement())
  refundId            Int
  paymentAllocationId Int
  amount              Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  refund            PaymentRefund            @relation(fields: [refundId], references: [id], onDelete: Restrict)
  paymentAllocation PaymentAllocation        @relation(fields: [paymentAllocationId], references: [id], onDelete: Restrict)
  creditReversals   CreditIssuanceReversal[]
  adjustments       FinancialAdjustment[]

  @@unique([refundId, paymentAllocationId])
  @@index([refundId])
  @@index([paymentAllocationId])
}

model CreditIssuanceReversal {
  id                        Int      @id @default(autoincrement())
  creditIssuanceId          Int
  paymentRefundAllocationId Int?
  creditsReversed           Int
  lessonCreditLogId         Int      @unique
  createdAt                 DateTime @default(now())
  createdById               Int
  voidedAt                  DateTime?
  voidedById                Int?
  voidLogId                 Int?     @unique

  creditIssuance          CreditIssuance           @relation(fields: [creditIssuanceId], references: [id], onDelete: Restrict)
  paymentRefundAllocation PaymentRefundAllocation? @relation(fields: [paymentRefundAllocationId], references: [id], onDelete: Restrict)
  lessonCreditLog         LessonCreditLog          @relation("CreditReversalLog", fields: [lessonCreditLogId], references: [id], onDelete: Restrict)
  createdBy               User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy                User?                    @relation("CreditReversalVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  voidLog                 LessonCreditLog?         @relation("CreditReversalVoidLog", fields: [voidLogId], references: [id], onDelete: SetNull)

  @@unique([creditIssuanceId, paymentRefundAllocationId])
  @@index([creditIssuanceId])
  @@index([paymentRefundAllocationId])
}

model FinancialAdjustment {
  id                        Int                       @id @default(autoincrement())
  schoolId                  Int
  studentProfileId          Int
  type                      FinancialAdjustmentType
  status                    FinancialAdjustmentStatus @default(ACTIVE)
  amountMoney               Decimal?                  @db.Decimal(12, 2)
  amountCredits             Int?
  reason                    String
  createdById               Int
  voidedById                Int?
  paymentRefundId           Int?
  paymentRefundAllocationId Int?
  creditIssuanceId          Int?
  lessonCreditLogId         Int?                      @unique
  createdAt                 DateTime                  @default(now())
  voidedAt                  DateTime?

  school                  School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentProfile          StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  createdBy               User                     @relation("FinancialAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy                User?                    @relation("FinancialAdjustmentVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  paymentRefund           PaymentRefund?           @relation(fields: [paymentRefundId], references: [id], onDelete: SetNull)
  paymentRefundAllocation PaymentRefundAllocation? @relation(fields: [paymentRefundAllocationId], references: [id], onDelete: SetNull)
  creditIssuance          CreditIssuance?          @relation(fields: [creditIssuanceId], references: [id], onDelete: SetNull)
  lessonCreditLog         LessonCreditLog?         @relation(fields: [lessonCreditLogId], references: [id], onDelete: SetNull)

  @@unique([paymentRefundAllocationId, creditIssuanceId, type])
  @@index([schoolId])
  @@index([studentProfileId])
  @@index([paymentRefundId])
  @@index([paymentRefundAllocationId])
  @@index([creditIssuanceId])
  @@index([schoolId, type])
}

