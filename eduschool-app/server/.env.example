DATABASE_URL="postgresql://postgres:admin@localhost:5432/eduschool?schema=public&connection_limit=10&pool_timeout=20"
JWT_SECRET="eduschool-super-secret-key-2026"
PORT=3001
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
DB_POOL_SIZE=10
LOG_LEVEL="info"

# Monitoring (optional, fill in production)
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_RELEASE=""

# OpenTelemetry tracing (optional — no-op if OTLP_ENDPOINT is unset)
OTEL_SERVICE_NAME="eduschool-api"
OTLP_ENDPOINT=""

# Redis for BullMQ queue (optional — falls back to sync if not set)
# Railway: redis://default:password@containers-us-west-1.railway.app:6379
REDIS_URL=""

# Cron / background jobs
# API processes in production should set DISABLE_CRON=true.
# A single worker process should run with cron enabled.
DISABLE_CRON=true

# Google OAuth ("Sign in with Google") — client ID from Google Cloud Console
GOOGLE_CLIENT_ID=""

# WebAuthn/passkey relying party ID — must be the bare domain (no scheme/port),
# e.g. "app.eduschool.com" in production. Defaults to "localhost" for dev.
RP_ID="localhost"

# Transactional email (Resend) — verification, password reset, welcome mail.
# Falls back to a dummy key + resend.dev sender if unset (emails won't send).
RESEND_API_KEY=""
FROM_EMAIL="onboarding@resend.dev"

# Maintenance scripts (server/src/scripts, src/lib/repairBase.ts) — not read
# by the running API/worker. SCHOOL_ID scopes a script to one tenant; DRY_RUN
# defaults to true (scripts must opt into writing with DRY_RUN=false).
SCHOOL_ID=""
DRY_RUN="true"

# Guards the destructive "clear all school data" endpoint. In production the
# endpoint refuses to run unless this is set to exactly "true"; outside
# production it's unguarded. Leave unset in production.
ALLOW_CLEAR_ALL_DATA=""
