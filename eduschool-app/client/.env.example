# Google OAuth ("Sign in with Google") — client ID from Google Cloud Console.
# Not a secret (client IDs are public by design), safe to commit the real
# value, but keeping an example here documents it for new devs.
VITE_GOOGLE_CLIENT_ID=""

# API origin. Empty in dev — requests go through the Vite proxy to
# http://localhost:3001 (see vite.config.ts). In production (client and API
# are separate Railway services, cross-origin) set this to the API's origin,
# e.g. "https://api.eduschool.example.com". If left unset on Railway, every
# API call resolves relative to the client's own static-file origin and 404s.
VITE_API_URL=""

# Monitoring (optional — Sentry is only initialized if VITE_SENTRY_DSN is set)
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT=""
VITE_SENTRY_RELEASE=""

# Build/release version shown in error reports. Usually injected by CI, not
# set by hand.
VITE_APP_VERSION=""
